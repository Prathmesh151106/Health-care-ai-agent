# API Base URL (Render backend or local development)
# In local development: http://localhost:4000
# On production: https://your-backend.onrender.com
# Leave blank to run in Demo mode
VITE_API_BASE_URL=

# Supabase Auth Configuration
# Obtain from your Supabase Project Settings -> API
# Required only if signing in with Google or Email
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
