# ─────────────────────────────────────────────────────────────
# Daily Health Companion – Backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env or share real values.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL – use the Render Internal Database URL in production
DATABASE_URL=postgresql://user:password@localhost:5432/daily_health_companion

# SSL: set to "true" on Render (uses ssl: { rejectUnauthorized: false })
DATABASE_SSL=false

# CORS – comma-separated list of allowed frontend origins
FRONTEND_URL=https://your-app.vercel.app
LOCAL_FRONTEND_URL=http://localhost:5173
# Optional extra origins (e.g. a specific Vercel preview URL – avoid wildcards)
EXTRA_ALLOWED_ORIGINS=

# Supabase – used to verify access tokens on the backend
SUPABASE_URL=https://your-project.supabase.co
# Use ONE of the two options below:
# Option A – symmetric HS256 JWT secret (found in Supabase dashboard → Settings → API)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Option B – JWKS URL for asymmetric RS256 (leave blank to use Option A)
SUPABASE_JWKS_URL=

# AI provider (optional – demo mode is used when this is absent)
AI_PROVIDER_API_KEY=
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai

# Rate limiting (optional overrides)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=10

# Request timeouts (ms)
REQUEST_TIMEOUT_MS=30000
AI_REQUEST_TIMEOUT_MS=60000
